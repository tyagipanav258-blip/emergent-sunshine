{
  "expo": {
    "name": "Sunshine",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sunshine",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sunshineapp.jme3k7",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ask questions about videos using your voice.",
        "NSCameraUsageDescription": "Scan your prescription to add medicines.",
        "NSPhotoLibraryUsageDescription": "Choose photos to share with your family, and add medicines from a prescription photo.",
        "NSMotionUsageDescription": "Count your daily steps so you and your family can see how active you have been.",
        "NSPhotoLibraryAddUsageDescription": "Save photos your family shares with you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.sunshineapp.jme3k7",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "ACTIVITY_RECOGNITION",
        "android.permission.ACTIVITY_RECOGNITION",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Ask questions about videos using your voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a prescription photo to add medicines.",
          "cameraPermission": "Scan your prescription to add medicines."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3A5A40",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
